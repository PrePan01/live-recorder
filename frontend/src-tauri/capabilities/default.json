{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Live Recorder desktop shell permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "notification:default",
    "dialog:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "process:default"
  ]
}