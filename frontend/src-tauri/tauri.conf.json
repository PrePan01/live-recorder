{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Live Recorder",
  "version": "0.5.121",
  "identifier": "com.live-recorder.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run bundle:resources"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Live Recorder",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "msi"
    ],
    "resources": {
      "../../backend": "backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": null
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": {
          "en-US": {
            "localePath": "./windows/locales/en-US.wxl"
          }
        }
      }
    }
  }
}
