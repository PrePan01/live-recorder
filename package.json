{
  "name": "live-recorder",
  "version": "0.5.115",
  "private": true,
  "description": "Live Recorder desktop application",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:real": "node scripts/dev.mjs real",
    "dev:fake": "node scripts/dev.mjs fake",
    "dev:tarui": "node scripts/dev-tauri.mjs",
    "dev:stop": "node scripts/stop-dev.mjs",
    "package": "node scripts/package.mjs",
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "install:ci": "npm --prefix backend ci && npm --prefix frontend ci",
    "version:set": "node scripts/version-set.mjs",
    "verify": "node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "prettier": "^3.9.6"
  }
}
