{
  "name": "@live-recorder/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地直播录制服务（localhost-only resident service）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "fastify": "^5.0.0",
    "nodemailer": "^6.9.0",
    "pino": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
