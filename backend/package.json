{
  "name": "@live-recorder/backend",
  "version": "0.5.100",
  "private": true,
  "type": "module",
  "description": "Local live recording service",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check:runtime": "node --expose-gc scripts/check-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "^5.0.0",
    "keytar": "^7.9.0",
    "nodemailer": "^6.9.0",
    "pino": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
